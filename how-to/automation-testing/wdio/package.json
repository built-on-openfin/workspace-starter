{
	"name": "automation-testing-wdio",
	"version": "24.0.0",
	"description": "HERE Core UI -- Automation tests using WebdriverIO",
	"private": true,
	"scripts": {
		"build": "echo Nothing to build",
		"test": "wdio run wdio.conf.mjs",
		"kill": "fkill -f -s OpenFin.exe OpenFinRVM.exe chromedriver.exe OpenFin OpenFinRVM chromedriver",
		"prettier": "prettier --config .prettierrc --write .",
		"prettier-check": "prettier --config .prettierrc --check .",
		"eslint": "eslint . --ext .js,.mjs,.ts",
		"markdownlint": "markdownlint **/*.md --ignore **/node_modules/**",
		"validate": "npm run prettier && npm run eslint && npm run markdownlint"
	},
	"license": "SEE LICENSE IN LICENSE.MD",
	"devDependencies": {
		"@openfin/automation-helpers": "^2.0.0-alpha.0",
		"@wdio/cli": "9.31.7",
		"@wdio/local-runner": "9.31.7",
		"@wdio/mocha-framework": "9.31.7",
		"@wdio/spec-reporter": "9.29.0",
		"chai": "5.1.2",
		"eslint": "8.57.1",
		"eslint-config-airbnb": "19.0.4",
		"eslint-config-airbnb-typescript": "18.0.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-import": "2.26.0",
		"eslint-plugin-jsdoc": "48.2.1",
		"eslint-plugin-prettier": "5.1.3",
		"eslint-plugin-promise": "6.1.1",
		"eslint-plugin-simple-import-sort": "12.0.0",
		"eslint-plugin-unicorn": "51.0.1",
		"eslint-plugin-unused-imports": "3.1.0",
		"fkill-cli": "8.0.0",
		"markdownlint-cli": "^0.48.0",
		"prettier": "3.2.5",
		"typescript": "^5.4.2"
	}
}
