[
	{
		"appId": "winform-interop-example",
		"name": "OpenFin Winform Interop Example",
		"title": "OpenFin Winform Interop Example",
		"description": "A Winform application built in .NET 4.8 that shows the power of our interop api.",
		"manifestType": "inline-appasset",
		"manifest": {
			"alias": "winform-interop-example",
			"version": "4.5.0",
			"args": "workspaceUUID={OF-PLAT-UUID} nativeUUID={OF-EXT-UUID} registerIntents",
			"src": "https://built-on-openfin.github.io/workspace-starter/dev/john/clean-npm-install/workspace-platform-starter/common/assets/native-interop-example.zip",
			"target": "OpenFin.Interop.Win.Sample.exe"
		},
		"icons": [
			{
				"src": "https://built-on-openfin.github.io/workspace-starter/dev/john/clean-npm-install/workspace-platform-starter/common/images/native/icon-winform-interop.png"
			}
		],
		"contactEmail": "contact@example.com",
		"supportEmail": "support@example.com",
		"publisher": "HERE",
		"intents": [
			{
				"name": "ViewContact",
				"displayName": "View Contact",
				"contexts": ["fdc3.contact"]
			},
			{
				"name": "ViewNews",
				"displayName": "View News",
				"contexts": ["fdc3.organization"]
			},
			{
				"name": "ViewInstrument",
				"displayName": "View Instrument",
				"contexts": ["fdc3.instrument"]
			}
		],
		"images": [
			{
				"src": "https://built-on-openfin.github.io/workspace-starter/dev/john/clean-npm-install/workspace-platform-starter/common/images/previews/native/openfin-winform-interop.png"
			}
		],
		"tags": ["native", "appasset", "dock", "developer"],
		"instanceMode": "multi",
		"launchPreference": {
			"options": {
				"type": "native",
				"snap": {
					"strategy": {
						"type": "waitForWindowOfName",
						"timeoutMs": 2000,
						"matchRegex": "^Interop Example Tool"
					}
				}
			}
		}
	},
	{
		"appId": "snap-native-test-app",
		"name": "Snap Native Test App",
		"title": "Snap Native Test App",
		"description": "A native application that can be used to demonstrate snapping.",
		"manifestType": "inline-appasset",
		"manifest": {
			"alias": "snap-native-test-app",
			"version": "1.0.0",
			"src": "https://built-on-openfin.github.io/workspace-starter/dev/john/clean-npm-install/workspace-platform-starter/common/assets/snap-native-test-app.zip",
			"target": "snap-native-test-app.exe"
		},
		"icons": [
			{
				"src": "https://built-on-openfin.github.io/workspace-starter/dev/john/clean-npm-install/workspace-platform-starter/common/images/favicon-32x32.png"
			}
		],
		"contactEmail": "contact@example.com",
		"supportEmail": "support@example.com",
		"publisher": "HERE",
		"intents": [],
		"images": [
			{
				"src": "https://built-on-openfin.github.io/workspace-starter/dev/john/clean-npm-install/workspace-platform-starter/common/images/previews/native/snap-native-test-app.png"
			}
		],
		"tags": ["native", "appasset", "developer"],
		"launchPreference": {
			"options": {
				"type": "native",
				"snap": {
					"strategy": {
						"type": "waitForWindowOfClass",
						"timeoutMs": 2000,
						"matchRegex": "^Window Class"
					}
				}
			}
		}
	},
	{
		"appId": "java-interop-example",
		"name": "Java Interop Example",
		"title": "Java Interop Example",
		"description": "A Java Application that shows the power of our interop api.",
		"manifestType": "inline-appasset",
		"instanceMode": "single",
		"manifest": {
			"alias": "java-interop-example",
			"version": "2.2.0",
			"args": "workspaceUUID={OF-PLAT-UUID} nativeUUID={OF-EXT-UUID} registerIntents",
			"src": "https://built-on-openfin.github.io/workspace-starter/dev/john/clean-npm-install/workspace-platform-starter/common/assets/openfin.starter.integrate.workspace.zip",
			"target": "openfin.starter.integrate.workspace-0.0.1-SNAPSHOT.jar"
		},
		"icons": [
			{
				"src": "https://built-on-openfin.github.io/workspace-starter/dev/john/clean-npm-install/workspace-platform-starter/common/images/favicon-32x32.png"
			}
		],
		"contactEmail": "contact@example.com",
		"supportEmail": "support@example.com",
		"publisher": "HERE",
		"intents": [
			{
				"name": "ViewInstrument",
				"displayName": "View Instrument",
				"contexts": ["fdc3.instrument"]
			}
		],
		"images": [
			{
				"src": "https://built-on-openfin.github.io/workspace-starter/dev/john/clean-npm-install/workspace-platform-starter/common/images/previews/native/openfin-java-interop.png"
			}
		],
		"tags": ["native", "appasset", "developer"],
		"launchPreference": {
			"options": {
				"type": "native",
				"snap": {
					"strategy": {
						"type": "combined",
						"matchClassRegex": "^SunAwtFrame",
						"matchNameRegex": "^Java ",
						"multiProcess": true
					}
				}
			}
		}
	},
	{
		"appId": "Notepad",
